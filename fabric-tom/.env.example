WORKSPACE_NAME=your-powerbi-workspace-name
TENANT_ID=your-tenant-id
APP_ID=your-app-id
APP_SECRET=your-app-secret
TARGET_DATASET_NAME=your-target-semantic-model-name
SQL_DATA_SOURCE_NAME=SqlDataSource
SQL_DIRECTQUERY_TABLE_NAME=SqlCompositeTable
SQL_DIRECTQUERY_PARTITION_NAME=All Rows
SQL_DIRECTQUERY_QUERY=SELECT ProductKey, ProductName FROM dbo.Products
SQL_DIRECTQUERY_COLUMNS=ProductKey:Int64:ProductKey;ProductName:String:ProductName

# 複数テーブルを追加する場合 (SQL_DIRECTQUERY_TABLE_COUNT を指定)
# SQL_DIRECTQUERY_TABLE_COUNT=2
# SQL_DIRECTQUERY_TABLE_1_NAME=SqlProducts
# SQL_DIRECTQUERY_TABLE_1_PARTITION_NAME=All Rows
# SQL_DIRECTQUERY_TABLE_1_QUERY=SELECT ProductKey, ProductName FROM dbo.Products
# SQL_DIRECTQUERY_TABLE_1_COLUMNS=ProductKey:Int64:ProductKey;ProductName:String:ProductName
# SQL_DIRECTQUERY_TABLE_2_NAME=SqlCustomers
# SQL_DIRECTQUERY_TABLE_2_PARTITION_NAME=All Rows
# SQL_DIRECTQUERY_TABLE_2_QUERY=SELECT CustomerKey, CustomerName FROM dbo.Customers
# SQL_DIRECTQUERY_TABLE_2_COLUMNS=CustomerKey:Int64:CustomerKey;CustomerName:String:CustomerName

SQL_SERVER=your-sql-server.database.windows.net
SQL_DATABASE=your-database-name
SQL_AUTH_MODE=SqlPassword

# SQL Server 認証
SQL_USER=your-sql-user
SQL_PASSWORD=your-sql-password

# Entra ID パスワード認証
# SQL_AUTH_MODE=EntraPassword
# SQL_ENTRA_USER=your-user@yourtenant.onmicrosoft.com
# SQL_ENTRA_PASSWORD=your-entra-password

# Entra ID MFA 認証
# SQL_AUTH_MODE=EntraInteractiveMfa
# SQL_ENTRA_USER=your-user@yourtenant.onmicrosoft.com

# Entra ID サービスプリンシパル認証
# SQL_AUTH_MODE=EntraServicePrincipal
# SQL_ENTRA_CLIENT_ID=your-entra-app-client-id
# SQL_ENTRA_CLIENT_SECRET=your-entra-app-client-secret

# Optional: if set, this is used as-is instead of the SQL_* values above.
# SQL_CONNECTION_STRING=Provider=MSOLEDBSQL;Data Source=your-sql-server.database.windows.net;Initial Catalog=your-database-name;Authentication=ActiveDirectoryPassword;User ID=your-user@yourtenant.onmicrosoft.com;Password=your-entra-password;Persist Security Info=True;
# Optional: defaults to MSOLEDBSQL
# SQL_PROVIDER=MSOLEDBSQL